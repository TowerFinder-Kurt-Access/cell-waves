---
import { ArrowRight, Phone } from "lucide-react"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { PHONE_DISPLAY, PHONE_HREF, SERVICE_PAGES } from "@/lib/content"

export interface ServiceSection {
  heading?: string
  level?: 2 | 3
  paragraphs: string[]
}

interface Props {
  title: string
  description: string
  heading: string
  intro: string[]
  image?: { src: string; alt: string }
  sections: ServiceSection[]
}

const { title, description, heading, intro, image, sections } = Astro.props

const pathname = Astro.url.pathname
let revealIndex = 0
---

<Base title={title} description={description}>
  <Header />
  <main class="bg-background">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
        <!-- Article -->
        <div class="lg:col-span-8">
          <div class="reveal">
            <p class="text-sm font-semibold uppercase tracking-widest text-brand">Our services</p>
            <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
              {heading}
            </h1>
            {intro.map((p) => (
              <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground">{p}</p>
            ))}
          </div>

          {
            image && (
              <div class="reveal mt-10 overflow-hidden rounded-2xl shadow-md ring-1 ring-border">
                <img src={image.src} alt={image.alt} class="aspect-[16/9] w-full object-cover" loading="eager" />
              </div>
            )
          }

          <div class="mt-12 space-y-12">
            {
              sections.map((section) => {
                const HeadingTag = section.level === 3 ? "h3" : "h2"
                const isLast = section === sections[sections.length - 1]
                revealIndex += 1
                return (
                  <section class="reveal" style={`--reveal-delay: ${(revealIndex % 2) * 60}ms`} data-last-section={isLast ? "" : undefined}>
                    {section.heading && (
                      <HeadingTag class:list={["font-bold tracking-tight text-ink", section.level === 3 ? "mt-2 text-xl font-semibold" : "text-2xl sm:text-3xl"]}>
                        {section.heading}
                      </HeadingTag>
                    )}
                    <div class:list={["space-y-4", section.heading && section.level !== 3 && "mt-4", section.heading && section.level === 3 && "mt-3"]}>
                      {section.paragraphs.map((p) => (
                        <p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground sm:text-base">{p}</p>
                      ))}
                    </div>
                  </section>
                )
              })
            }
          </div>
        </div>

        <!-- Sidebar: sibling services + call card -->
        <aside class="lg:col-span-4">
          <div class="space-y-6 lg:sticky lg:top-32">
            <div class="reveal reveal-right rounded-2xl border border-border bg-card p-5 shadow-sm">
              <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Our services</h2>
              <ul class="mt-3 space-y-1">
                {
                  SERVICE_PAGES.map((page) => (
                    <li>
                      <a
                        href={page.href}
                        aria-current={pathname === page.href ? "page" : undefined}
                        class:list={[
                          "block rounded-lg px-3 py-2 text-sm transition-colors",
                          pathname === page.href
                            ? "bg-brand-muted font-semibold text-brand"
                            : "text-muted-foreground hover:bg-secondary hover:text-ink",
                        ]}
                      >
                        {page.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <a
              href={PHONE_HREF}
              class="reveal reveal-right flex items-center gap-4 rounded-2xl border border-border bg-card p-5 shadow-sm transition-shadow hover:shadow-md"
              style="--reveal-delay: 80ms"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-brand-foreground">
                <Phone className="h-5 w-5" strokeWidth={2} aria-hidden="true" />
              </span>
              <span>
                <span class="block text-sm font-semibold text-ink">Call us anytime</span>
                <span class="mt-0.5 block text-sm text-muted-foreground">{PHONE_DISPLAY}</span>
              </span>
            </a>
          </div>
        </aside>
      </div>

      <!-- Closing CTA band -->
      <div class="reveal mt-16 rounded-2xl bg-brand px-6 py-12 text-center sm:px-12">
        <h2 class="text-3xl font-bold leading-tight text-brand-foreground">
          Get a free review of your lease
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-brand-foreground/85">
          Send us your lease details and we will come back within one business
          day. No obligation.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/#contact"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-white px-6 text-base font-semibold text-brand shadow-sm transition-all hover:bg-white/90 active:translate-y-[1px]"
          >
            Get a free review
            <ArrowRight className="h-4 w-4" strokeWidth={2} />
          </a>
          <a
            href={PHONE_HREF}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-white/30 px-6 text-base font-semibold text-brand-foreground transition-colors hover:bg-white/10 active:translate-y-[1px]"
          >
            <Phone className="h-4 w-4" strokeWidth={2} />
            {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>
