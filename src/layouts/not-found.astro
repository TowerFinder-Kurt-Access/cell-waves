---
import { ArrowRight, Home, Phone } from "lucide-react"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { getBundle } from "@/i18n"
import { PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"
import { localeFromPath, localizePath } from "@/lib/i18n"

// One layout serves both /404 and /fr/404: the locale comes from the URL.
const locale = localeFromPath(Astro.url.pathname)
const t = getBundle<Record<string, string>>(locale, "ui", "notFound")
const header = getBundle<Record<string, string>>(locale, "ui", "header")

const PATHS = [
  { href: "/#services", label: t.services },
  { href: "/blog", label: t.blog },
  { href: "/about-us", label: t.about },
  { href: "/testimonials", label: t.testimonials },
]
const otherLocale = locale === "fr" ? "en" : "fr"
const otherHref = locale === "fr" ? "/404" : "/fr/404"
---

<Base title={t.title} description={t.body} noindex>
  <Header />
  <main class="bg-background">
    <section class="relative overflow-hidden">
      <!-- ambient depth: never flat -->
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.6]"
        aria-hidden="true"
        style="background:
          radial-gradient(900px 520px at 12% 0%, oklch(0.92 0.04 232 / 0.55), transparent 55%),
          radial-gradient(700px 420px at 100% 100%, oklch(0.94 0.05 230 / 0.45), transparent 60%);"
      >
      </div>

      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
        <div class="reveal mx-auto max-w-3xl text-center">
          <p class="font-heading text-[11px] font-bold uppercase tracking-[0.35em] text-brand">404</p>
          <h1
            class="mt-4 font-heading text-[clamp(2rem,4vw,3.25rem)] font-bold leading-[1.05] tracking-tighter text-ink"
          >
            {t.heading}
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-[17px]">
            {t.body}
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href={localizePath(locale, "/")}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-brand px-6 text-sm font-semibold text-brand-foreground shadow-sm transition-all hover:brightness-110 active:translate-y-[1px]"
            >
              <Home className="h-4 w-4" strokeWidth="2" aria-hidden="true" />
              {t.home}
            </a>
            <a
              href={PHONE_HREF}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-border bg-card px-6 text-sm font-semibold text-ink shadow-sm transition-colors hover:border-brand/40"
            >
              <Phone className="h-4 w-4 text-brand" strokeWidth="2" aria-hidden="true" />
              {PHONE_DISPLAY}
            </a>
          </div>
        </div>

        <div class="reveal mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" style="--reveal-delay: 80ms">
          {
            PATHS.map(({ href, label }) => (
              <a
                href={localizePath(locale, href)}
                class="group flex items-center justify-between gap-3 rounded-2xl border border-border bg-card p-5 shadow-sm transition-shadow hover:shadow-md"
              >
                <span class="text-sm font-semibold text-ink">{label}</span>
                <ArrowRight
                  className="h-4 w-4 shrink-0 text-brand transition-transform duration-300 group-hover:translate-x-0.5"
                  strokeWidth="2"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>

        <div class="reveal mt-10 flex items-center justify-center gap-3" style="--reveal-delay: 160ms">
          <a
            href={localizePath(locale, "/#contact")}
            class="text-sm font-semibold text-brand transition-colors hover:text-ink"
          >
            {header.cta}
          </a>
          <span class="text-muted-foreground/40" aria-hidden="true">&#8226;</span>
          <a
            href={otherHref}
            data-locale={otherLocale}
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-ink"
          >
            {t.switch}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
