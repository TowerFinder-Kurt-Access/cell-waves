---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "CellWaves - Cell Tower Lease Experts for Landlords",
  description = "CellWaves Wireless Consultants: expert cell tower lease negotiation for Canadian landlords. Maximize your lease renewals and buyouts.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>
