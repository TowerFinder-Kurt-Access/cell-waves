---
import "@/styles/global.css"
import Analytics from "@vercel/analytics/astro"
import { CookieConsent } from "@/components/site/cookie-consent"
import {
  SITE,
  absoluteUrl,
  breadcrumbSchema,
  ogImageSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
} from "@/lib/seo"
import { getBundle } from "@/i18n"
import { HTML_LANG, localeFromPath, localizePath, stripLocale } from "@/lib/i18n"

interface Props {
  title?: string
  description?: string
  /** Absolute or site-relative URL of the Open Graph image. */
  image?: string
  type?: "website" | "article"
  keywords?: string
  noindex?: boolean
  /** Extra JSON-LD blocks merged after the defaults. */
  schema?: Record<string, unknown> | Record<string, unknown>[]
}

const locale = localeFromPath(Astro.url.pathname)
const meta = getBundle<Record<string, string>>(locale, "ui", "meta")
const {
  title = meta.defaultTitle,
  description = meta.defaultDescription,
  image = SITE.ogImage,
  type = "website",
  keywords = SITE.keywords.join(", "),
  noindex = false,
  schema,
} = Astro.props
const neutralPath = stripLocale(Astro.url.pathname)
const canonical = absoluteUrl(Astro.url.pathname)
const imageUrl = absoluteUrl(image)
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : []
const allSchema = [
  organizationSchema(),
  websiteSchema(),
  ogImageSchema(),
  webPageSchema({ title, description, url: canonical, type, locale }),
  breadcrumbSchema(Astro.url.pathname, title, locale),
  ...extraSchema,
]
// Blog posts exist in English only; a /fr twin would 404, so skip that alternate.
const hasFrTwin = !/^\/blog\/.+/.test(neutralPath)
---

<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Locale preference: explicit choice (footer toggle, stored in localStorage)
      // wins; otherwise French-browser visitors land on the /fr twin. Runs before
      // paint so the redirect is invisible. Blog posts are English-only: never touch.
      ;(() => {
        try {
          const KEY = "cw-locale"
          const path = location.pathname
          if (/^\/blog\//.test(path)) return
          const onFr = path === "/fr" || path.startsWith("/fr/")
          const current = onFr ? "fr" : "en"
          const browserFr = (navigator.language || "").toLowerCase().startsWith("fr")
          const wanted = localStorage.getItem(KEY) || (browserFr ? "fr" : null)
          if (wanted === "fr" && current !== "fr") {
            location.replace("/fr" + path + location.search + location.hash)
          } else if (wanted === "en" && current === "fr") {
            location.replace(path.slice(3) + location.search + location.hash || "/")
          }
          document.addEventListener("click", (e) => {
            const a = e.target && e.target.closest ? e.target.closest("a[data-locale]") : null
            if (a) localStorage.setItem(KEY, a.getAttribute("data-locale"))
          })
        } catch {}
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE.name} />
    <meta name="creator" content={SITE.name} />
    <meta name="publisher" content={SITE.name} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(localizePath("en", neutralPath))} />
    {hasFrTwin && <link rel="alternate" hreflang="fr" href={absoluteUrl(localizePath("fr", neutralPath))} />}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizePath("en", neutralPath))} />

    <link rel="icon" type="image/webp" href="/brand.webp?v=1" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <slot />
    <Analytics />
    <CookieConsent client:load locale={locale} />
    <script>
      // Scroll-reveal trigger: hide .reveal elements only once JS is confirmed,
      // then play each entrance once when it enters the viewport.
      document.documentElement.dataset.reveal = "on"

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed")
                observer.unobserve(entry.target)
              }
            }
          },
          { threshold: 0, rootMargin: "0px 0px -40px 0px" },
        )
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el))
      } else {
        delete document.documentElement.dataset.reveal
      }
    </script>
  </body>
</html>