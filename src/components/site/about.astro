---
import { Building2, Handshake } from "lucide-react"
import { ABOUT_IMAGE } from "@/lib/content"

const STATS = [
  { icon: Handshake, value: "24", label: "Significant lease terms we review" },
  { icon: Building2, value: "20+", label: "Branch affiliates nationwide" },
]
---

<section id="about" class="bg-background">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Visual -->
      <div class="reveal reveal-left order-2 lg:order-1 lg:col-span-5">
        <div class="relative">
          <div class="overflow-hidden rounded-2xl shadow-md ring-1 ring-border">
            <img
              src={ABOUT_IMAGE}
              alt="Two professionals shaking hands over a lease agreement"
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
            />
          </div>
          <div
            class="absolute -right-4 top-8 flex items-baseline gap-2 rounded-2xl bg-brand px-6 py-4 text-brand-foreground shadow-md sm:-right-6"
          >
            <span
              data-count-up
              data-target="35"
              class="font-heading text-4xl font-bold tabular-nums sm:text-5xl">1</span
            >
            <span class="text-lg font-semibold">Years</span>
          </div>
        </div>
      </div>

      <!-- Copy -->
      <div class="reveal reveal-right order-1 lg:order-2 lg:col-span-7">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">About us</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-ink sm:text-4xl">
          Unlock the full potential of your telecom lease renewal
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
          At CellWaves, we specialize in helping property owners maximize the
          value of their telecom lease agreements. We negotiate better lease
          renewal deals for owners leasing their land to telecom companies, the
          antennas typically 15-24 feet tall.
        </p>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
          Unlike other brokers, we don't secure new deals for property owners.
          We focus on those approached for lease renewals, turning an offer of a
          few hundred dollars into a deal worth thousands.
        </p>

        <dl
          class="mt-10 grid grid-cols-1 gap-6 rounded-2xl bg-muted px-6 py-6 sm:grid-cols-2 sm:px-8"
        >
          {
            STATS.map((s) => (
              <div class="flex items-center gap-4">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand text-brand-foreground">
                  <s.icon className="size-6" strokeWidth={1.8} aria-hidden="true" />
                </span>
                <div>
                  <dt class="sr-only">{s.label}</dt>
                  <dd class="font-heading text-2xl font-bold text-brand">{s.value}</dd>
                  <dd class="mt-0.5 text-sm leading-snug text-muted-foreground">{s.label}</dd>
                </div>
              </div>
            ))
          }
        </dl>
        <a
          href="/about-us"
          class="mt-8 inline-flex h-11 items-center justify-center rounded-full bg-brand px-6 text-sm font-semibold uppercase tracking-wide text-brand-foreground shadow-sm transition-all hover:brightness-110 active:translate-y-[1px]"
        >
          Read about us
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "@/scripts/count-up"
</script>
