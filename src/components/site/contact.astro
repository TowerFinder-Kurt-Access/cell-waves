---
import { ContactAside, ContactForm } from "@/components/site/contact-form"
---

<section id="contact" class="bg-background">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
          Ready to unlock your property's full value?
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
          Do not settle for the first offer. Schedule a free consultation and
          find out how much your cell site could really earn.
        </p>
        <div class="mt-8">
          <ContactAside client:load />
        </div>
      </div>
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>
