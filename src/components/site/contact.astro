---
import { ContactForm } from "@/components/site/contact-form"
import { EMAIL, LOCATION, PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"
import { Mail, MapPin, Phone } from "lucide-react"
---

<section id="contact" class="bg-background">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
    <!-- Header - vertical stack, not split -->
    <div class="max-w-2xl">
      <h2 class="text-4xl font-bold leading-none tracking-tighter text-ink sm:text-5xl lg:text-[2.95rem]">
        Talk to a landlord side specialist
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-[17px]">
        Free review. No obligation. Tell us about your lease and we respond within one business day.
      </p>
    </div>

    <!-- Body - asymmetric 12-col bento, map is visual -->
    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-12">
      <!-- Form - 7 cols, primary -->
      <div class="lg:col-span-7">
        <ContactForm client:load />
        <p class="mt-4 text-center text-xs leading-5 text-muted-foreground sm:text-left">
          Your details stay private. We never share with carriers. No carrier affiliation.
        </p>
      </div>

      <!-- Info + Map - 5 cols, stacked with breathing -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <!-- Info - no heavy card, border-y grouping -->
        <div class="rounded-2xl border border-border bg-card">
          <div class="space-y-0 divide-y divide-border">
            <a href={PHONE_HREF} class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-secondary/40">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand text-brand-foreground">
                <Phone className="h-4 w-4" strokeWidth="2" />
              </span>
              <span>
                <span class="block text-xs uppercase tracking-widest text-muted-foreground">Phone</span>
                <span class="block text-sm font-semibold text-ink">{PHONE_DISPLAY}</span>
              </span>
              <span class="ml-auto hidden text-xs text-muted-foreground sm:block">Call anytime</span>
            </a>
            <a href={`mailto:${EMAIL}`} class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-secondary/40">
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-background text-ink">
                <Mail className="h-4 w-4" strokeWidth="2" />
              </span>
              <span>
                <span class="block text-xs uppercase tracking-widest text-muted-foreground">Email</span>
                <span class="block text-sm font-semibold text-ink">{EMAIL}</span>
              </span>
            </a>
            <div class="flex items-start gap-4 px-6 py-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border bg-background text-ink">
                <MapPin className="h-4 w-4" strokeWidth="2" />
              </span>
              <span>
                <span class="block text-xs uppercase tracking-widest text-muted-foreground">Office</span>
                <span class="block max-w-[28ch] text-sm leading-6 text-muted-foreground">{LOCATION}</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Google Maps embed - real visual, bento diversity -->
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="relative aspect-[16/11] w-full overflow-hidden bg-secondary lg:aspect-[4/3]">
            <iframe
              title="CellWaves office on Google Maps"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2448.429!2d-106.678!3d52.131!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5304f6dc5a5a5a5a%3A0x0!2s1539%20Bradwell%20Ave%2C%20Saskatoon%2C%20SK!5e0!3m2!1sen!2sca!4v1720000000000"
              width="600"
              height="450"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              class="absolute inset-0 h-full w-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
