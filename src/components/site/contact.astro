---
import { ContactForm } from "@/components/site/contact-form"
import { EMAIL, LOCATION, LOCATION_HREF, PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"
import { Mail, MapPin, Phone } from "lucide-react"
---

<section id="contact" class="relative overflow-hidden border-t border-border bg-secondary/30">
  <!-- depth spot, breathing not flat -->
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true" style="background: radial-gradient(700px 380px at 80% 100%, oklch(0.935 0.03 231 / 0.45), transparent 60%);"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
    <div class="max-w-3xl">
      <h2 class="text-4xl font-bold leading-none tracking-tighter text-ink sm:text-5xl lg:text-[2.85rem]">
        Ready to see what your site is really worth?
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-[17px]">
        Free review. No obligation. Your details stay private. Tell us about your lease and we respond within one business day.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Left: map + contact details - 5 cols -->
      <div class="order-2 flex flex-col gap-6 lg:order-1 lg:col-span-5">
        <!-- info list -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
          <h3 class="text-sm font-semibold tracking-tight text-ink">Reach us directly</h3>
          <ul class="mt-5 space-y-4">
            <li>
              <a href={PHONE_HREF} class="group flex items-center gap-3 text-sm">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand text-brand-foreground">
                  <Phone className="h-4 w-4" strokeWidth="2" />
                </span>
                <span class="font-medium text-ink group-hover:underline decoration-border underline-offset-4">{PHONE_DISPLAY}</span>
                <span class="ml-auto hidden text-xs text-muted-foreground sm:inline">Call us anytime</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${EMAIL}`} class="group flex items-center gap-3 text-sm">
                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-ink">
                  <Mail className="h-4 w-4" strokeWidth="2" />
                </span>
                <span class="font-medium text-ink group-hover:underline decoration-border underline-offset-4">{EMAIL}</span>
              </a>
            </li>
            <li class="flex items-start gap-3 text-sm">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-background text-ink">
                <MapPin className="h-4 w-4" strokeWidth="2" />
              </span>
              <span class="leading-relaxed text-muted-foreground">{LOCATION}</span>
            </li>
          </ul>
        </div>

        <!-- Map - real visual, bento diversity -->
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <div class="relative aspect-[16/11] w-full overflow-hidden bg-secondary sm:aspect-[16/10] lg:aspect-[4/3]">
            <iframe
              title="CellWaves office location"
              src="https://www.openstreetmap.org/export/embed.html?bbox=-106.697%2C52.120%2C-106.660%2C52.140&amp;layer=mapnik&amp;marker=52.131%2C-106.678"
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="absolute inset-0 h-full w-full"
            ></iframe>
            <a
              href="https://www.openstreetmap.org/?mlat=52.131&amp;mlon=-106.678#map=15/52.131/-106.678"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute bottom-2 right-2 rounded-full bg-white px-2.5 py-1 text-[10px] font-semibold text-ink shadow-sm"
            >
              View larger map
            </a>
          </div>
          <div class="flex items-center justify-between gap-4 border-t border-border bg-card px-5 py-4">
            <p class="text-xs leading-5 text-muted-foreground">
              1539 Bradwell Ave, Saskatoon
              <span class="hidden sm:inline"> - Open in Maps for directions</span>
            </p>
            <a
              href={LOCATION_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-8 shrink-0 items-center justify-center rounded-full border border-border bg-background px-3 text-xs font-semibold text-ink hover:bg-accent"
            >
              Open Maps
            </a>
          </div>
        </div>

        <p class="px-1 text-xs leading-5 text-muted-foreground">
          Office visits by appointment. Serving landlords coast to coast. No carrier affiliation.
        </p>
      </div>

      <!-- Right: form - 7 cols -->
      <div class="order-1 lg:order-2 lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>
