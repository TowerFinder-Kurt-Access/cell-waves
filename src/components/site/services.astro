---
import { ArrowRight, FileCheck, RadioTower, Signal } from "lucide-react"
import { SERVICES } from "@/lib/content"

const [first, ...rest] = SERVICES
const icons = [RadioTower, Signal, FileCheck]
---

<section id="services" class="border-y border-border bg-secondary/40">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        Our expertise covers the full life of your lease
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        From the first proposal letter to the final buyout signature, we focus
        on one outcome: a stronger agreement for the property owner.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Large cell -->
      <a
        href={first.href}
        class="reveal group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow hover:shadow-md"
      >
        <div class="relative overflow-hidden">
          <img
            src={first.image}
            alt={first.alt}
            class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand text-brand-foreground">
              <RadioTower className="h-4.5 w-4.5" strokeWidth={1.8} aria-hidden="true" />
            </span>
            <h3 class="text-xl font-semibold text-ink">{first.title}</h3>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
            {first.description}
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
            Read more
            <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" strokeWidth="2" />
          </span>
        </div>
      </a>

      <!-- Stacked cells -->
      <div class="grid grid-cols-1 gap-6">
        {rest.map((s, i) => {
          const Icon = icons[i + 1] ?? Signal
          return (
            <a
              href={s.href}
              style={`--reveal-delay: ${(i + 1) * 70}ms`}
              class="reveal group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow hover:shadow-md sm:flex-row"
            >
              <div class="relative shrink-0 overflow-hidden sm:w-44">
                <img
                  src={s.image}
                  alt={s.alt}
                  class="aspect-[16/10] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] sm:aspect-auto"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-muted text-brand">
                    <Icon className="h-4.5 w-4.5" strokeWidth={1.8} aria-hidden="true" />
                  </span>
                  <h3 class="text-lg font-semibold text-ink">{s.title}</h3>
                </div>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {s.description}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
                  Read more
                  <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" strokeWidth="2" />
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </div>
</section>
