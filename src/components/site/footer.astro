---
import { Mail, MapPin, Phone } from "lucide-react"
import {
  EMAIL,
  FOOTER_ABOUT,
  FOOTER_SERVICES,
  FOOTER_USEFUL_LINKS,
  LOCATION,
  LOCATION_HREF,
  PHONE_DISPLAY,
  PHONE_HREF,
  SITE_NAME,
} from "@/lib/content"
import { localeFromPath, localizePath, stripLocale, type Locale } from "@/lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const neutral = stripLocale(Astro.url.pathname)
const en = {
  useful: "Useful links",
  services: "Our Services",
  contact: "Contact Us",
  cta: "Free consultation",
  rights: "All rights reserved.",
  privacy: "Privacy Policy",
  terms: "Terms and Conditions",
  language: "Language",
}
const fr: typeof en = {
  useful: "Liens utiles",
  services: "Nos services",
  contact: "Nous joindre",
  cta: "Consultation gratuite",
  rights: "Tous droits réservés.",
  privacy: "Politique de confidentialité",
  terms: "Conditions générales",
  language: "Langue",
}
const t = locale === "fr" ? fr : en
const year = new Date().getFullYear()
---

<footer class="relative overflow-hidden border-t border-white/10 bg-[#0A0A0A] text-white">
  <!-- single subtle depth spot - breathing, not flat, not overkill -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    aria-hidden="true"
    style="background: radial-gradient(800px 500px at 20% 0%, rgba(255,255,255,0.09), transparent 62%);"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-14 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.25fr] lg:gap-16">
      <!-- Brand - editorial, airy -->
      <div class="lg:pr-8">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={localizePath(locale, "/")} class="flex items-center gap-2.5" aria-label={locale === "fr" ? "CellWaves accueil" : "CellWaves home"}>
            <img
              src="/cellwaves-logo.webp"
              alt=""
              width={385}
              height={385}
              class="h-12 w-auto"
              loading="lazy"
            />
            <span class="flex flex-col leading-none">
              <span class="font-heading text-xl font-bold tracking-tight text-white">Cell Waves</span>
              <span class="mt-1 text-[11px] font-semibold uppercase tracking-[0.25em] text-white/60">Canada</span>
            </span>
          </a>
          <img
            src="/canadian.webp"
            alt="Proudly Canadian"
            width={1280}
            height={393}
            class="h-10 w-auto"
            loading="lazy"
          />
        </div>
        <p class="mt-5 max-w-sm text-sm leading-7 text-white/55">
          {FOOTER_ABOUT[locale]}
        </p>
      </div>

      <!-- Useful links - divider as whitespace, not heavy borders -->
      <nav aria-label={t.useful}>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">{t.useful}</h4>
        <ul class="mt-6 space-y-3.5">
          {FOOTER_USEFUL_LINKS[locale].map((item) => (
            <li>
              <a href={localizePath(locale, item.href)} class="text-sm leading-6 text-white/60 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Our services -->
      <nav aria-label={t.services}>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">{t.services}</h4>
        <ul class="mt-6 space-y-3.5">
          {FOOTER_SERVICES[locale].map((item) => (
            <li>
              <a href={localizePath(locale, item.href)} class="text-sm leading-6 text-white/60 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact - no heavy bento, just breathing list -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">{t.contact}</h4>
        <ul class="mt-6 space-y-5">
          <li>
            <a href={PHONE_HREF} class="group flex items-start gap-3 text-sm">
              <Phone className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/70 group-hover:text-white">{PHONE_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`} class="group flex items-start gap-3 text-sm">
              <Mail className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/70 group-hover:text-white">{EMAIL}</span>
            </a>
          </li>
          <li>
            <a
              href={LOCATION_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 text-sm"
            >
              <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/55 group-hover:text-white/80">{LOCATION}</span>
            </a>
          </li>
        </ul>
        <a
          href={localizePath(locale, "/#contact")}
          class="mt-8 inline-flex h-10 items-center justify-center rounded-full bg-white px-6 text-sm font-semibold text-black transition-colors hover:bg-white/90 active:translate-y-px"
        >
          {t.cta}
        </a>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-white/5 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs leading-6 text-white/30">Copyright {year} {SITE_NAME}. {t.rights}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-white/30">
        <a href={localizePath(locale, "/privacy-policy")} class="transition-colors hover:text-white">{t.privacy}</a>
        <a href={localizePath(locale, "/terms-and-conditions")} class="transition-colors hover:text-white">{t.terms}</a>
        <nav aria-label={t.language} class="flex items-center gap-0.5 rounded-full border border-white/10 p-0.5">
          {(["en", "fr"] as Locale[]).map((code) => (
            <a
              href={localizePath(code, neutral)}
              hreflang={code}
              aria-current={code === locale ? "true" : undefined}
              class:list={[
                "flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-widest transition-colors",
                code === locale ? "bg-white/10 text-white" : "text-white/40 hover:text-white/70",
              ]}
            >
              {code === "fr" ? (
                <svg viewBox="0 0 3 2" class="h-3 w-[18px] shrink-0 rounded-[2px]" aria-hidden="true" focusable="false">
                  <rect width="3" height="2" fill="#fff" />
                  <rect width="1" height="2" fill="#002395" />
                  <rect x="2" width="1" height="2" fill="#ed2939" />
                </svg>
              ) : (
                <img src="/canadian.webp" alt="" width={1280} height={393} class="h-3 w-[18px] shrink-0 rounded-[2px] object-cover" loading="lazy" />
              )}
              {code}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>
