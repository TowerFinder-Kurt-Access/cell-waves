---
import { Mail, MapPin, Phone } from "lucide-react"
import {
  EMAIL,
  FOOTER_ABOUT,
  FOOTER_SERVICES,
  FOOTER_USEFUL_LINKS,
  LOCATION,
  LOCATION_HREF,
  PHONE_DISPLAY,
  PHONE_HREF,
  SITE_NAME,
} from "@/lib/content"

const year = new Date().getFullYear()
---

<footer class="relative overflow-hidden border-t border-white/10 bg-[#0A0A0A] text-white">
  <!-- single subtle depth spot - breathing, not flat, not overkill -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    aria-hidden="true"
    style="background: radial-gradient(800px 500px at 20% 0%, rgba(255,255,255,0.09), transparent 62%);"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-14 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.25fr] lg:gap-16">
      <!-- Brand - editorial, airy -->
      <div class="lg:pr-8">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="/" class="flex items-center gap-2.5" aria-label="CellWaves home">
            <img
              src="/cellwaves-logo.webp"
              alt=""
              width={385}
              height={385}
              class="h-12 w-auto"
              loading="lazy"
            />
            <span class="font-heading text-xl font-bold tracking-tight text-white">Cell Waves</span>
          </a>
          <img
            src="/canadian.webp"
            alt="Proudly Canadian"
            width={1280}
            height={393}
            class="h-10 w-auto"
            loading="lazy"
          />
        </div>
        <p class="mt-5 max-w-sm text-sm leading-7 text-white/55">
          {FOOTER_ABOUT}
        </p>
      </div>

      <!-- Useful links - divider as whitespace, not heavy borders -->
      <nav aria-label="Useful links">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">Useful links</h4>
        <ul class="mt-6 space-y-3.5">
          {FOOTER_USEFUL_LINKS.map((item) => (
            <li>
              <a href={item.href} class="text-sm leading-6 text-white/60 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Our services -->
      <nav aria-label="Our services">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">Our Services</h4>
        <ul class="mt-6 space-y-3.5">
          {FOOTER_SERVICES.map((item) => (
            <li>
              <a href={item.href} class="text-sm leading-6 text-white/60 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact - no heavy bento, just breathing list -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-white/35">Contact Us</h4>
        <ul class="mt-6 space-y-5">
          <li>
            <a href={PHONE_HREF} class="group flex items-start gap-3 text-sm">
              <Phone className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/70 group-hover:text-white">{PHONE_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`} class="group flex items-start gap-3 text-sm">
              <Mail className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/70 group-hover:text-white">{EMAIL}</span>
            </a>
          </li>
          <li>
            <a
              href={LOCATION_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 text-sm"
            >
              <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-white/40 group-hover:text-white" strokeWidth="1.8" />
              <span class="leading-6 text-white/55 group-hover:text-white/80">{LOCATION}</span>
            </a>
          </li>
        </ul>
        <a
          href="/#contact"
          class="mt-8 inline-flex h-10 items-center justify-center rounded-full bg-white px-6 text-sm font-semibold text-black transition-colors hover:bg-white/90 active:translate-y-px"
        >
          Free consultation
        </a>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-white/5 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs leading-6 text-white/30">Copyright {year} {SITE_NAME}. All rights reserved.</p>
      <div class="flex items-center gap-6 text-xs text-white/30">
        <a href="#top" class="transition-colors hover:text-white">Privacy Policy</a>
        <a href="#top" class="transition-colors hover:text-white">Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>
