---
import { ChevronDown, Phone, Radio } from "lucide-react"
import { NAV_ITEMS, PHONE_DISPLAY, PHONE_HREF, SITE_NAME } from "@/lib/content"
import { MobileNav } from "@/components/site/mobile-nav"
---

<header class="fixed inset-x-0 top-4 z-50 px-4 sm:top-5 sm:px-6">
  <!-- web glassmorphism approximation (see skill Appendix C): black translucent dock -->
  <div
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 rounded-full border border-white/10 bg-black/85 pl-4 pr-2 shadow-lg shadow-black/20 backdrop-blur-xl supports-[backdrop-filter]:bg-black/70 sm:pl-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-heading text-base font-bold text-white">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand text-brand-foreground">
        <Radio className="h-4.5 w-4.5" strokeWidth="2" />
      </span>
      {SITE_NAME}
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {NAV_ITEMS.map((item) =>
        item.children ? (
          <div class="group relative">
            <a
              href={item.href}
              class="flex items-center gap-1 rounded-full px-3 py-2 text-[13px] whitespace-nowrap font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white"
            >
              {item.label}
              <ChevronDown className="h-3.5 w-3.5 transition-transform group-hover:rotate-180" strokeWidth="2" />
            </a>
            <div class="invisible absolute left-0 top-full z-50 w-72 translate-y-1 pt-2 opacity-0 transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              <ul class="rounded-2xl border border-white/10 bg-black/85 p-1.5 shadow-lg shadow-black/30 backdrop-blur-xl">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block rounded-xl px-3 py-2.5 text-sm text-white/75 transition-colors hover:bg-white/10 hover:text-white"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="rounded-full px-3 py-2 text-[13px] whitespace-nowrap font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white"
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <a
        href={PHONE_HREF}
        class="flex items-center gap-2 rounded-full px-3 py-2 text-[13px] font-semibold text-white/80 transition-colors hover:text-white"
      >
        <Phone className="h-3.5 w-3.5 text-brand" strokeWidth="2" />
        {PHONE_DISPLAY}
      </a>
      <a
        href="/#contact"
        class="inline-flex h-10 items-center justify-center rounded-full bg-brand px-5 text-[13px] font-semibold text-brand-foreground transition-all hover:brightness-110 active:translate-y-[1px]"
      >
        Free consultation
      </a>
    </div>

    <div class="lg:hidden">
      <MobileNav client:load />
    </div>
  </div>
</header>
