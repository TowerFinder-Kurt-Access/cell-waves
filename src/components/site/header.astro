---
import { ChevronDown, Phone, Radio } from "lucide-react"
import { NAV_ITEMS, PHONE_DISPLAY, PHONE_HREF, SITE_NAME } from "@/lib/content"
import { MobileNav } from "@/components/site/mobile-nav"

const pathname = Astro.url.pathname
const isActive = (href: string) => {
  if (href === "/") return pathname === "/"
  if (href === "/blog") return pathname.startsWith("/blog")
  return pathname === href
}
const isParentActive = (item: (typeof NAV_ITEMS)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false)
---

<header class="fixed inset-x-0 top-4 z-50 px-4 sm:top-5 sm:px-6">
  <div
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 rounded-full border border-white/10 bg-black/85 pl-4 pr-2 shadow-lg shadow-black/20 backdrop-blur-xl supports-[backdrop-filter]:bg-black/70 sm:pl-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-heading text-base font-bold text-white">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand text-brand-foreground">
        <Radio className="h-4.5 w-4.5" strokeWidth="2" />
      </span>
      {SITE_NAME}
    </a>

    <nav id="primary-nav" class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {
        NAV_ITEMS.map((item) =>
          item.children ? (
            <div class="group relative" data-nav-parent>
              <a
                href={item.href}
                data-href={item.href}
                aria-current={isParentActive(item) ? "page" : undefined}
                class:list={[
                  "flex items-center gap-1 rounded-full px-3 py-2 text-[13px] whitespace-nowrap font-medium transition-colors",
                  isParentActive(item) ? "text-white" : "text-white/70 hover:bg-white/10 hover:text-white",
                ]}
              >
                {item.label}
                <ChevronDown className="h-3.5 w-3.5 transition-transform group-hover:rotate-180" strokeWidth="2" />
              </a>
              <div class="invisible absolute left-0 top-full z-50 w-72 translate-y-1 pt-2 opacity-0 transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                <ul class="rounded-2xl border border-white/10 bg-black/85 p-1.5 shadow-lg shadow-black/30 backdrop-blur-xl">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        data-href={child.href}
                        aria-current={isActive(child.href) ? "page" : undefined}
                        class:list={[
                          "block rounded-xl px-3 py-2.5 text-sm transition-colors",
                          isActive(child.href) ? "text-white" : "text-white/75 hover:bg-white/10 hover:text-white",
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              data-href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-full px-3 py-2 text-[13px] whitespace-nowrap font-medium transition-colors",
                isActive(item.href) ? "text-white" : "text-white/70 hover:bg-white/10 hover:text-white",
              ]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <a
        href={PHONE_HREF}
        class="flex items-center gap-2 rounded-full px-3 py-2 text-[13px] font-semibold text-white/80 transition-colors hover:text-white"
      >
        <Phone className="h-3.5 w-3.5 text-brand" strokeWidth="2" />
        {PHONE_DISPLAY}
      </a>
      <a
        href="/#contact"
        class="inline-flex h-10 items-center justify-center rounded-full bg-brand px-5 text-[13px] font-semibold text-brand-foreground transition-all hover:brightness-110 active:translate-y-[1px]"
      >
        Free consultation
      </a>
    </div>

    <div class="lg:hidden">
      <MobileNav client:load />
    </div>
  </div>
</header>
<div class="h-6 sm:h-8" aria-hidden="true"></div>

<script is:inline>
  (function () {
    const nav = document.getElementById("primary-nav");
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll("a[data-href]"));
    const hashLinks = links.filter((a) => {
      const h = a.getAttribute("data-href") || "";
      return h.startsWith("/#");
    });
    const topLinks = links.filter((a) => {
      const h = a.getAttribute("data-href") || "";
      return h === "/" || h === "/blog";
    });
    function updateFromLocation() {
      const path = location.pathname;
      const hash = location.hash;
      if (path.startsWith("/blog")) {
        links.forEach((el) => {
          const h = el.getAttribute("data-href");
          const isTop = el.classList.contains("rounded-full") && !el.closest("ul");
          const isDropdownParent = !!el.closest("[data-nav-parent]") && el.parentElement?.hasAttribute("data-nav-parent");
          const shouldActive = h === "/blog" && !isDropdownParent;
          if (!isTop) return;
          if (shouldActive) {
            el.classList.add("text-white");
            el.classList.remove("text-white/70");
            el.setAttribute("aria-current", "page");
          } else if (h === "/blog") {
            el.classList.remove("text-white");
            el.classList.add("text-white/70");
            el.removeAttribute("aria-current");
          }
        });
        hashLinks.forEach((el) => {
          const isTop = el.classList.contains("rounded-full") && !el.closest("ul");
          if (isTop) {
            el.classList.remove("text-white");
            el.classList.add("text-white/70");
            el.removeAttribute("aria-current");
          } else {
            el.classList.remove("text-white");
            if (!el.classList.contains("text-white/75")) el.classList.add("text-white/75");
          }
        });
        return;
      }
      if (hash) {
        const href = "/#" + hash.slice(1);
        hashLinks.forEach((el) => {
          const h = el.getAttribute("data-href");
          const isTop = el.classList.contains("rounded-full") && !el.closest("ul");
          const active = h === href;
          if (isTop) {
            if (active) {
              el.classList.add("text-white");
              el.classList.remove("text-white/70");
              el.setAttribute("aria-current", "page");
            } else {
              el.classList.remove("text-white");
              if (!el.classList.contains("text-white/70")) el.classList.add("text-white/70");
              el.removeAttribute("aria-current");
            }
          } else {
            if (active) {
              el.classList.add("text-white");
              el.classList.remove("text-white/75");
              el.setAttribute("aria-current", "page");
            } else {
              el.classList.remove("text-white");
              if (!el.classList.contains("text-white/75")) el.classList.add("text-white/75");
              el.removeAttribute("aria-current");
            }
          }
        });
        topLinks.forEach((el) => {
          if (el.getAttribute("data-href") === "/") {
            el.classList.remove("text-white");
            el.classList.add("text-white/70");
            el.removeAttribute("aria-current");
          }
        });
        hashLinks.forEach((el) => {
          if (el.getAttribute("data-href") === href) {
            const group = el.closest("[data-nav-parent]");
            if (group) {
              const parent = group.querySelector(":scope > a[data-href]");
              if (parent && parent !== el) {
                parent.classList.add("text-white");
                parent.classList.remove("text-white/70");
                parent.setAttribute("aria-current", "page");
              }
            }
          }
        });
        return;
      }
      if (path === "/") {
        hashLinks.forEach((el) => {
          const isTop = el.classList.contains("rounded-full") && !el.closest("ul");
          if (isTop) {
            el.classList.remove("text-white");
            if (!el.classList.contains("text-white/70")) el.classList.add("text-white/70");
            el.removeAttribute("aria-current");
          } else {
            el.classList.remove("text-white");
            if (!el.classList.contains("text-white/75")) el.classList.add("text-white/75");
            el.removeAttribute("aria-current");
          }
        });
        topLinks.forEach((el) => {
          if (el.getAttribute("data-href") === "/") {
            el.classList.add("text-white");
            el.classList.remove("text-white/70");
            el.setAttribute("aria-current", "page");
          }
        });
      }
    }
    const sectionIds = ["about", "why", "services", "testimonials", "contact"];
    const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);
    let observer = null;
    if (sections.length && "IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (location.hash) return;
          const visible = entries.filter((e) => e.isIntersecting);
          if (!visible.length) return;
          visible.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          const id = visible[0].target.id;
          if (!id) return;
          const href = "/#" + id;
          hashLinks.forEach((el) => {
            const h = el.getAttribute("data-href");
            const isTop = el.classList.contains("rounded-full") && !el.closest("ul");
            const active = h === href;
            if (isTop) {
              if (active) {
                el.classList.add("text-white");
                el.classList.remove("text-white/70");
              } else {
                if (!location.hash) {
                  el.classList.remove("text-white");
                  if (!el.classList.contains("text-white/70")) el.classList.add("text-white/70");
                }
              }
            } else {
              if (active) {
                el.classList.add("text-white");
                el.classList.remove("text-white/75");
              } else {
                if (!location.hash) {
                  el.classList.remove("text-white");
                  if (!el.classList.contains("text-white/75")) el.classList.add("text-white/75");
                }
              }
            }
          });
          const home = topLinks.find((a) => a.getAttribute("data-href") === "/");
          if (home) {
            if (!location.hash) {
              home.classList.remove("text-white");
              if (!home.classList.contains("text-white/70")) home.classList.add("text-white/70");
            }
          }
          hashLinks.forEach((el) => {
            if (el.getAttribute("data-href") === href) {
              const group = el.closest("[data-nav-parent]");
              if (group) {
                const parent = group.querySelector(":scope > a[data-href]");
                if (parent && !location.hash) {
                  parent.classList.add("text-white");
                  parent.classList.remove("text-white/70");
                }
              }
            }
          });
        },
        { rootMargin: "-50% 0px -50% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] }
      );
      sections.forEach((s) => observer.observe(s));
    }
    updateFromLocation();
    window.addEventListener("hashchange", updateFromLocation);
    window.addEventListener("popstate", updateFromLocation);
  })();
</script>
