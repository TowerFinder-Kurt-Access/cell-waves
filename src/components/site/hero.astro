---
import { ArrowRight, CheckCircle2 } from "lucide-react"
import { HERO_IMAGE } from "@/lib/content"
---

<section id="top" class="relative -mt-6 flex min-h-[75dvh] flex-col overflow-hidden bg-background sm:-mt-8">
  <!-- Huge background : full bleed behind dock, fades to white at bottom -->
  <div class="absolute inset-0">
    <img
      src={HERO_IMAGE}
      alt="Cell tower against bright sky"
      class="h-full w-full object-cover object-right sm:object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/80 to-white/40 lg:from-white lg:via-white/70 lg:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-l from-ink/40 via-ink/10 to-transparent lg:from-ink/30"></div>
    <!-- Mobile body scrim so text reads cleanly over the towers -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/40 to-transparent lg:hidden"></div>
    <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-white via-white/80 to-transparent"></div>
  </div>
  <div class="relative z-10 flex flex-1 flex-col justify-center">
    <div class="mx-auto w-full max-w-7xl px-4 py-14 pt-24 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <p class="reveal-load inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-ink">
          <CheckCircle2 className="h-3.5 w-3.5 text-brand" strokeWidth="2" />
          Cell tower lease with wireless landlords
        </p>
        <h1 class="reveal-load reveal-load-d2 mt-4 font-heading text-5xl font-bold leading-[0.9] tracking-tighter sm:text-6xl lg:text-[4.4rem]">
          <span class="block text-brand">CELL TOWER LEASE</span>
          <span class="mt-3 block text-lg font-semibold leading-snug tracking-tight text-ink sm:text-xl lg:text-2xl">
            Professionals on your side.
          </span>
        </h1>
        <p class="reveal-load reveal-load-d3 mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
          Fair market value starts with knowing what your site delivers. We negotiate renewals, extensions, and buyouts for Canadian property owners.
        </p>
        <div class="reveal-load reveal-load-d4 mt-7">
          <a
            href="#contact"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-brand px-6 text-sm font-semibold uppercase tracking-wide text-brand-foreground shadow-sm transition-all hover:brightness-110 active:translate-y-[1px]"
          >
            Let's Get Started
            <ArrowRight className="h-3.5 w-3.5" strokeWidth="2" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
