---
import { ArrowRight, Phone } from "lucide-react"
import { HERO_IMAGE, PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"
---

<section id="top" class="relative overflow-hidden bg-background">
  <!-- subtle blueprint grid - retained, opacity tuned -->
  <div
    class="pointer-events-none absolute inset-0 [background-image:linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] [background-size:56px_56px] opacity-[0.32] [mask-image:radial-gradient(ellipse_75%_60%_at_50%_0%,black,transparent)]"
    aria-hidden="true"
  />
  <!-- soft warm spot for depth - tasteskill depth without flat empty -->
  <div
    class="pointer-events-none absolute -top-24 right-[-10%] h-[520px] w-[520px] rounded-full bg-brand/5 blur-3xl"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 pt-24 pb-20 sm:px-6 lg:px-8 lg:pt-24 lg:pb-28">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Copy - 7 cols for asymmetry -->
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand-muted px-3.5 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand">
          Are you getting fair market rent?
        </p>
        <h1 class="mt-5 max-w-[16ch] text-4xl font-bold leading-[0.96] tracking-tighter text-ink sm:text-5xl lg:text-[3.45rem]">
          Cell tower lease with wireless landlords.
          <span class="block pb-1 leading-[1.08] text-brand">Professionals on your side.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Fair market value starts with knowing what your site delivers. We negotiate renewals, extensions, and buyouts for Canadian property owners.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#contact"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-brand px-7 text-base font-semibold text-brand-foreground shadow-sm transition-all hover:brightness-110 active:translate-y-[1px]"
          >
            Let's get started
            <ArrowRight className="h-4 w-4" strokeWidth="2" />
          </a>
          <a
            href={PHONE_HREF}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-border bg-card px-6 text-base font-semibold text-ink transition-colors hover:bg-accent"
          >
            <Phone className="h-4 w-4 text-brand" strokeWidth="2" />
            {PHONE_DISPLAY}
          </a>
        </div>

        <div class="mt-6 hidden items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted-foreground sm:flex">
          <span>35+ years combined</span>
          <span class="h-1 w-1 rounded-full bg-border"></span>
          <span>Landlord-side only</span>
          <span class="h-1 w-1 rounded-full bg-border"></span>
          <span>No carrier rep</span>
        </div>
      </div>

      <!-- Visual - 5 cols, layered, image never overlaid with pill -->
      <div class="relative lg:col-span-5">
        <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
          <img
            src={HERO_IMAGE}
            alt="Metal cell tower under a blue sky"
            class="aspect-[4/3] w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/25 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute bottom-3 right-3 rounded-full border border-white/20 bg-black/55 px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest text-white backdrop-blur">
            Saskatoon - 52N 106W
          </div>
        </div>

        <!-- stat card - depth element, not a pill over image -->
        <div class="absolute -bottom-6 left-4 right-4 sm:left-6 sm:right-auto">
          <div class="rounded-xl border border-border bg-card/95 p-5 shadow-md backdrop-blur sm:max-w-[19rem]">
            <p class="font-heading text-3xl font-bold tracking-tight text-brand">35+ years</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
              Combined expertise in leasing, wireless engineering, and buyouts across Canada.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
