---
import { ArrowRight } from "lucide-react"
import { POSTS } from "@/lib/content"

const posts = POSTS.slice(0, 3)
---

<section id="insights" class="border-y border-border bg-secondary/40">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">Blog and articles</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-ink sm:text-4xl">
          Our latest blog and article
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
          Practical reading on lease rates, negotiation, and what your site is
          really worth.
        </p>
      </div>
      <a
        href="/blog"
        class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-brand transition-colors hover:text-ink"
      >
        View all articles
        <ArrowRight className="h-4 w-4" strokeWidth="2" />
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow hover:shadow-md"
        >
          <div class="overflow-hidden">
            <img
              src={post.image}
              alt={post.alt}
              class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <time class="text-xs font-medium uppercase tracking-wider text-brand">
              {post.date}
            </time>
            <h3 class="mt-2.5 text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-brand">
              {post.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
              {post.excerpt}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
