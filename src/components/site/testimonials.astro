---
import { TestimonialCarousel } from "@/components/site/testimonial-carousel"
---

<section id="testimonials" class="relative overflow-hidden border-y border-border bg-background">
  <!-- depth - soft spot, no flat empty -->
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true" style="background: radial-gradient(700px 400px at 70% 0%, oklch(0.935 0.03 231 / 0.55), transparent 60%);"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
        Client feedback - 07 verified
      </p>
      <h2 class="mt-4 text-3xl font-bold leading-[1.05] tracking-tighter text-ink sm:text-4xl lg:text-[2.6rem]">
        Landlords and managers on working with CellWaves
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Seven reports from Quebec to British Columbia. Unedited excerpts, tied to outcome - not hourly.
      </p>
    </div>

    <div class="mt-10">
      <TestimonialCarousel client:visible />
    </div>
  </div>
</section>
