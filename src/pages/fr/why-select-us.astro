---
import { ArrowRight, Phone } from "lucide-react"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"

const PILLARS = [
  {
    title: "Expertise sectorielle",
    body: "Forte d'une vaste expérience dans le secteur sans fil, CellWaves offre une compréhension approfondie des nuances de l'industrie. Notre équipe aide les propriétaires à maximiser la valeur de leurs actifs sans fil grâce à des approches novatrices et stratégiques. Plutôt que de s'appuyer sur des repères de paiement désuets, nous évaluons votre bail de façon globale pour nous assurer que vous obtenez le rendement le plus élevé possible.",
  },
  {
    title: "Détection des pièges et des offres trompeuses",
    body: "De nombreux propriétaires sont victimes de discours trompeurs de prétendus acheteurs de baux chevronnés qui les persuadent de vendre sous la valeur marchande. Internet est saturé de consultants auto-proclamés en baux de tours de téléphonie mobile qui n'ont aucune expérience réelle de l'industrie. Souvent, ces personnes n'ont jamais travaillé dans le domaine sans fil et ont simplement été formées pour suivre des scripts de vente dans des centres d'appels. Chez CellWaves, nous privilégions la transparence et une connaissance éprouvée de l'industrie pour protéger vos intérêts et vous aider à prendre des décisions éclairées et rentables.",
  },
]

const EXPERTISE = [
  {
    title: "Expérience du zonage, de l'utilisation des sols et des conditions d'approbation",
    body: "À première vue, un négociateur novice ne comprendrait pas l'incidence du zonage sur la valeur du bail. Pour CellWaves, comprendre le zonage fait toutefois la différence entre obtenir le maximum de loyer pour nos clients et obtenir des montants de loyer moyens.",
  },
  {
    title: "Compréhension des enjeux, des coûts et des risques de construction",
    body: "Bien des négociateurs de baux n'abordent jamais ces points, car ils ne saisissent pas les implications de ce niveau de connaissance ni la valeur qu'il apporte aux propriétaires. Une compréhension approfondie de la construction sans fil, qui diffère énormément de toute autre forme de construction résidentielle ou commerciale, permet de protéger, de défendre et de négocier les droits des propriétaires, les risques commerciaux et juridiques, et de détenir un avantage négociateur assorti des meilleurs prix pour les propriétaires sans fil.",
  },
  {
    title: "Initiés expérimentés des opérations des opérateurs sans fil",
    body: "Avoir travaillé au sein des opérations d'un opérateur sans fil, c'est en comprendre les processus, le raisonnement, les priorités, les valeurs et les contacts. C'est extrêmement important, car vos consultants peuvent devoir faire escalader une affaire au-delà des mandataires des opérateurs sans fil, et le consultant doit savoir comment s'y prendre correctement. L'anticipation des mouvements des opérateurs sans fil est également très importante, ce qui ne peut se faire qu'avec une expérience d'initié.",
  },
  {
    title: "Une équipe de professionnels au service des intérêts des clients sans fil",
    body: "Un cabinet de consultation performant doit être plus qu'un one-man-show. L'entreprise doit compter une équipe aux compétences et expériences variées, ainsi qu'un réseau de personnel de soutien pour traiter les transactions des clients sans accroc.",
  },
  {
    title: "Un vaste réseau de contacts dans l'industrie",
    body: "Les contacts sont importants, et les renseignements recueillis auprès de l'industrie au cas par cas se sont révélés inestimables pour nos clients.",
  },
]

const WSU_IMAGE =
  "https://images.unsplash.com/photo-1557174360-3f4f7c724501?q=80&w=1200&auto=format&fit=crop"
---

<Base
  title="Pourquoi nous choisir - CellWaves"
  description="Découvrez pourquoi les propriétaires et les propriétaires d'immeubles font confiance à CellWaves pour la négociation experte de baux de tours de téléphonie mobile, des ententes équitables et des services de consultation auprès des opérateurs sans fil."
>
  <Header />
  <main class="bg-background">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <!-- Intro: visual + years badge left, copy right -->
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="reveal reveal-left order-2 lg:order-1 lg:col-span-5">
          <div class="relative">
            <div class="overflow-hidden rounded-2xl shadow-md ring-1 ring-border">
              <img
                src={WSU_IMAGE}
                alt="Site sans fil sur un immeuble résidentiel"
                class="aspect-[4/5] w-full object-cover"
                loading="eager"
              />
            </div>
            <div
              class="absolute -right-4 top-8 flex items-baseline gap-2 rounded-2xl bg-brand px-6 py-4 text-brand-foreground shadow-md sm:-right-6"
            >
              <span class="font-heading text-4xl font-bold tabular-nums sm:text-5xl">
                <span data-count-up data-target="35">1</span>+
              </span>
              <span class="text-lg font-semibold">Années</span>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right order-1 lg:order-2 lg:col-span-7">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">Pourquoi nous choisir</p>
          <h1 class="mt-3 text-4xl font-bold leading-tight text-ink sm:text-5xl">
            CellWaves donne aux propriétaires un meilleur contrôle et une valeur accrue
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
            Dans l'industrie sans fil, les opérateurs et les sociétés de tours
            font souvent appel à des négociateurs chevronnés qui ont traité des
            centaines de baux. En revanche, la plupart des propriétaires n'ont
            négocié qu'un seul bail sans fil dans leur vie. Au cours de ce
            processus, qui a réellement dicté les conditions, comme le loyer et
            le libellé du contrat? En général, ce sont les opérateurs. Bien des
            propriétaires entament les négociations avec des connaissances
            limitées en technologie sans fil, en évaluation, en tarification et
            en conditions juridiques, ce qui les rend vulnérables aux ententes
            unilatérales rédigées par les avocats des opérateurs.
          </p>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
            Même pour ceux qui souhaitent négocier, le défi est de savoir quoi
            changer et pourquoi. Sans une compréhension claire des comparables du
            marché, surtout lorsque les conditions des baux sans fil sont
            confidentielles et ne sont pas publiées, les propriétaires s'en
            remettent souvent aux renseignements fournis par le représentant de
            l'acquisition de sites. Mais ce représentant agit-il dans votre
            meilleur intérêt, ou est-il incité à obtenir des taux de loyer plus
            bas qui profitent à l'opérateur et augmentent sa propre rémunération?
          </p>
        </div>
      </div>

      <!-- Pillars -->
      <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-2">
        {
          PILLARS.map((p, i) => (
            <div class="reveal rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="font-heading text-sm font-bold tracking-widest text-brand">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h2 class="mt-2 text-xl font-semibold text-ink">{p.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
            </div>
          ))
        }
      </div>

      <!-- Expertise -->
      <div class="mt-20">
        <h2 class="reveal text-3xl font-bold leading-tight text-ink sm:text-4xl">Notre expertise</h2>
        <div class="mt-10 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2">
          {
            EXPERTISE.map((e, i) => (
              <div class="reveal border-t-2 border-brand/20 pt-5" style={`--reveal-delay: ${(i % 2) * 70}ms`}>
                <span class="font-heading text-2xl font-bold text-brand">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-ink">{e.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  {e.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Closing CTA band -->
      <div class="reveal mt-20 rounded-2xl bg-brand px-6 py-12 text-center sm:px-12">
        <h2 class="text-3xl font-bold leading-tight text-brand-foreground">
          Ne vous défavorisez pas sur l'un de vos actifs les plus précieux
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-brand-foreground/85">
          Nous avons négocié des milliers de transactions de sites cellulaires
          au nom de propriétaires. Appelez-nous à tout moment pour une
          consultation sans engagement.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/fr/#contact"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-white px-6 text-base font-semibold text-brand shadow-sm transition-all hover:bg-white/90 active:translate-y-[1px]"
          >
            Obtenir une révision gratuite
            <ArrowRight className="h-4 w-4" strokeWidth={2} />
          </a>
          <a
            href={PHONE_HREF}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-white/30 px-6 text-base font-semibold text-brand-foreground transition-colors hover:bg-white/10 active:translate-y-[1px]"
          >
            <Phone className="h-4 w-4" strokeWidth={2} />
            {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    import "@/scripts/count-up"
  </script>
</Base>
