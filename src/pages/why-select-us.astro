---
import { Phone } from "lucide-react"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { PHONE_ALT_DISPLAY, PHONE_ALT_HREF, TEAM } from "@/lib/content"

const PILLARS = [
  {
    title: "Industry expertise",
    body: "With extensive experience in the wireless sector, CellWaves offers a deep understanding of the industry's nuances. Our team helps landlords maximize the value of their wireless assets through innovative and strategic approaches. Rather than relying on outdated payment benchmarks, we assess your lease holistically to ensure you're getting the highest possible return.",
  },
  {
    title: "Identifying traps and misleading offers",
    body: "Many landlords fall victim to misleading pitches from so-called expert lease buyers who persuade them to sell below market value. The internet is saturated with self-proclaimed cell tower consultants who lack real-world industry experience. Often, these individuals have never worked in the wireless field and were merely trained to follow sales scripts in call centers. At CellWaves, we prioritize transparency and proven industry knowledge to protect your interests and ensure you make informed, profitable decisions.",
  },
]

const EXPERTISE = [
  {
    title: "Experienced in zoning, land use, and conditions of approvals",
    body: "On its face, a novice negotiator would not understand the implication that zoning has to the value of the lease. To CellWaves, however, understanding zoning is the difference between getting maximum rental dollars for our clients and getting average rental amounts.",
  },
  {
    title: "Understand construction issues, costs, and risks",
    body: "Many lease negotiators never discuss these points because they do not understand the implications of this level of knowledge and the value it brings to landlords. A deep understanding of wireless construction, which is very different from any other form of residential and commercial construction, means being able to protect, defend, and negotiate landlord property rights, business and legal risks, and have a negotiating advantage along with top dollars for wireless landlords.",
  },
  {
    title: "Experienced insiders of wireless carrier operations",
    body: "Having worked inside a wireless carrier operation means understanding their processes, thinking, priorities, values, and contacts. This is extremely important since your consultants may need to escalate a matter beyond the wireless carriers' agents, and the consultant must know how to go about it correctly. Anticipation of wireless carriers' moves is also very important, which can only be done with insider experience.",
  },
  {
    title: "A support team of professionals to advance wireless clients' interests",
    body: "A successful consultancy company must be more than a one-man show. The company must have a team of people with varied skills and experience and a network of supporting staff to smoothly process transactions for clients.",
  },
  {
    title: "Wide-ranging industry contacts",
    body: "Contacts are important, and the information gathered from the industry on a case-by-case basis has proven to be invaluable for our clients.",
  },
]

const LARRY = TEAM[0]
---

<Base
  title="Why Select Us - CellWaves"
  description="Discover why landlords and property owners trust CellWaves for expert cell tower lease negotiations, fair agreements, and wireless carrier consulting services."
>
  <Header />
  <main class="bg-background">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <!-- Intro -->
      <div class="reveal max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">Why select us</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight text-ink sm:text-5xl">
          CellWaves empowers landlords with greater control and enhanced value
        </h1>
        <p class="mt-5 text-base leading-relaxed text-muted-foreground">
          In the wireless industry, carriers and tower companies often employ
          seasoned negotiators who have handled hundreds of lease agreements. In
          contrast, most property owners have negotiated only a single wireless
          lease in their lifetime. During that process, who truly dictated the
          terms, such as rent and contract language? Typically, it's the
          carriers. Many landlords enter negotiations with limited knowledge of
          wireless technology, valuation, pricing, and legal terms, making them
          vulnerable to one-sided agreements crafted by carrier attorneys.
        </p>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
          Even for those who wish to negotiate, the challenge is knowing what to
          change and why. Without a clear understanding of market comparables,
          especially when wireless lease terms are confidential and not publicly
          recorded, landlords often rely on information provided by the site
          acquisition representative. But is that representative working in your
          best interest, or are they incentivized to secure lower lease rates
          that benefit the carrier and increase their own compensation?
        </p>
      </div>

      <!-- Pillars -->
      <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-2">
        {
          PILLARS.map((p, i) => (
            <div class="reveal border-t-2 border-brand/20 pt-5" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="font-heading text-sm font-bold tracking-widest text-brand">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h2 class="mt-2 text-xl font-semibold text-ink">{p.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
            </div>
          ))
        }
      </div>

      <!-- Call band -->
      <a
        href={PHONE_ALT_HREF}
        class="reveal mt-16 flex items-center justify-center gap-4 rounded-2xl bg-muted px-6 py-6 transition-colors hover:bg-muted/70"
      >
        <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand text-brand-foreground">
          <Phone className="size-5" strokeWidth={1.8} aria-hidden="true" />
        </span>
        <span>
          <span class="block text-lg font-semibold text-ink">Call us anytime</span>
          <span class="block text-sm font-medium text-brand">{PHONE_ALT_DISPLAY}</span>
        </span>
      </a>

      <!-- Expertise -->
      <div class="mt-20">
        <h2 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">Our expertise</h2>
        <ol class="mt-10 space-y-10">
          {
            EXPERTISE.map((e, i) => (
              <li class="reveal grid gap-3 border-t border-border pt-6 sm:grid-cols-12 sm:gap-6" style={`--reveal-delay: ${(i % 2) * 60}ms`}>
                <span class="font-heading text-2xl font-bold text-brand sm:col-span-2">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="sm:col-span-10">
                  <h3 class="text-lg font-semibold text-ink">{e.title}</h3>
                  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">
                    {e.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-10 max-w-3xl text-base leading-relaxed text-muted-foreground">
          CellWaves meets all the above conditions. Nowhere else can you find
          the combination of experience, skills, and passion to deliver
          incredible value for our clients. Don't disadvantage yourself by
          hiring inexperienced self-professed internet negotiators working on
          one of your most valuable assets. We have negotiated thousands of cell
          site transactions on behalf of property owners. Call us anytime for a
          no-obligation consultation.
        </p>
      </div>

      <!-- Senior team -->
      <div class="reveal mt-20 grid items-center gap-10 rounded-2xl bg-muted p-6 sm:p-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="overflow-hidden rounded-2xl shadow-sm ring-1 ring-border">
            <img
              src={LARRY.image}
              alt={LARRY.alt}
              class="aspect-[6/7] w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">Our senior team</p>
          <h2 class="mt-2 text-2xl font-bold text-ink">
            {LARRY.name} <span class="font-medium text-muted-foreground">(President)</span>
          </h2>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            Larry is the Wall Street guy. His extensive finance and Wall Street
            experience makes him ideal to identify finance solutions for our
            clients. Whether our clients want payment in a single lump sum,
            spread out over the course of several years, or some other
            arrangement, chances are that Larry will be speaking with the
            client.
          </p>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            Larry is extremely creative in solving deal points and arrangements,
            financial details, and complications that require his expertise to
            help resolve. His experience has come from decades of
            feet-on-the-street as a site acquisition guy knocking on doors. He
            used to knock on doors of landlords and ask if he could place cell
            sites on their property for $500 a month. Those were the early days
            of the industry. Today, Larry can work for you in getting the
            highest rents for your cell tower lease contracts.
          </p>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            Now that Larry is representing landlords on the same transactions,
            he can be a real asset to best understand how your lease works. If
            you already have a site on your property, the next time the wireless
            carrier asks for permission to perform upgrades you should deny the
            upgrade and call us immediately. Larry will tell you if the
            carrier's upgrade request is fair, and if not, what we should do
            about it to benefit the landlord equitably.
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>
