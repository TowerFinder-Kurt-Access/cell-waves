---
import { type CollectionEntry, getCollection, render } from "astro:content"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { PHONE_DISPLAY, PHONE_HREF } from "@/lib/content"
import { articleSchema, absoluteUrl } from "@/lib/seo"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content } = await render(post)
const date = post.data.pubDate.toLocaleDateString("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<Base
  title={`${post.data.title} - CellWaves`}
  description={post.data.description}
  type="article"
  schema={articleSchema({
    title: post.data.title,
    description: post.data.description,
    url: absoluteUrl(`/blog/${post.id}`),
    datePublished: post.data.pubDate,
    image: post.data.heroImage,
  })}
>
  <Header />
  <main class="bg-background">
    <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <a href="/blog" class="text-sm font-medium text-brand transition-colors hover:text-ink">
        Back to all articles
      </a>
      <h1 class="mt-4 text-3xl font-bold leading-tight text-ink sm:text-4xl">
        {post.data.title}
      </h1>
      <time class="mt-3 block text-sm text-muted-foreground">{date}</time>

      {post.data.heroImage && (
        <div class="mt-8 overflow-hidden rounded-2xl shadow-md ring-1 ring-border">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <div class="prose-content mt-10">
        <Content />
      </div>

      <div class="mt-14 rounded-2xl border border-border bg-secondary/40 p-8 text-center">
        <h2 class="text-2xl font-bold text-ink">Have anything to ask?</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Talk to a lease expert about your property.
        </p>
        <a
          href={PHONE_HREF}
          class="mt-5 inline-flex h-12 items-center justify-center rounded-lg bg-brand px-6 text-base font-semibold text-brand-foreground shadow-sm transition-all hover:brightness-110"
        >
          Call {PHONE_DISPLAY}
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .prose-content :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
  }
  .prose-content :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }
  .prose-content :global(p) {
    margin-top: 1.1rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--muted-foreground);
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-top: 1.1rem;
    padding-left: 1.4rem;
    color: var(--muted-foreground);
    line-height: 1.75;
  }
  .prose-content :global(ul) {
    list-style: disc;
  }
  .prose-content :global(ol) {
    list-style: decimal;
  }
  .prose-content :global(li) {
    margin-top: 0.4rem;
  }
  .prose-content :global(a) {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-content :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose-content :global(blockquote) {
    margin-top: 1.5rem;
    border-left: 3px solid var(--brand);
    padding-left: 1rem;
    color: var(--ink);
    font-style: italic;
  }
  .prose-content :global(img) {
    margin-top: 1.5rem;
    border-radius: 0.75rem;
  }
</style>
