---
import { Star } from "lucide-react"
import Footer from "@/components/site/footer.astro"
import Header from "@/components/site/header.astro"
import Base from "@/layouts/base.astro"
import { PAGE_TESTIMONIALS } from "@/lib/content"
---

<Base
  title="Client Testimonials - CellWaves"
  description="See what landlords, property managers, and tower site owners say about working with CellWaves. Real success stories in cell tower lease consulting and negotiations."
>
  <Header />
  <main class="bg-background">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <!-- Intro -->
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">Testimonials</p>
        <h1 class="mt-3 text-4xl font-bold leading-none tracking-tighter text-ink sm:text-5xl">
          What landlords say after the lease is signed
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-[17px]">
          Ten reports from Quebec to British Columbia. Real names, cities, and
          sites you can verify.
        </p>
      </div>

      <!-- Testimonials -->
      <div class="mt-16 space-y-20 sm:space-y-24">
        {
          PAGE_TESTIMONIALS.map((t, i) => (
            <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
              {/* Quote side */}
              <div class:list={["lg:col-span-7", i % 2 === 1 && "lg:order-2"]}>
                <div class="flex items-center gap-3">
                  <div class="flex gap-1 text-brand" aria-label="5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <Star className="size-4" fill="currentColor" strokeWidth={0} aria-hidden="true" />
                    ))}
                  </div>
                  <span class="font-mono text-xs tracking-widest text-muted-foreground">
                    {String(i + 1).padStart(2, "0")} / {String(PAGE_TESTIMONIALS.length).padStart(2, "0")}
                  </span>
                </div>

                <p class="mt-5 text-xs font-semibold uppercase tracking-widest text-brand">
                  {t.title}
                </p>

                <blockquote class="mt-3 max-w-[36ch] text-2xl font-bold leading-[1.15] tracking-tighter text-ink sm:text-[1.75rem]">
                  <span class="text-brand/30">&ldquo;</span>
                  {t.paragraphs[0]}
                  <span class="text-brand/30">&rdquo;</span>
                </blockquote>

                {t.paragraphs.length > 1 && (
                  <div class="mt-5 max-w-2xl space-y-3">
                    {t.paragraphs.slice(1).map((p) => (
                      <p class="text-sm leading-relaxed text-muted-foreground">{p}</p>
                    ))}
                  </div>
                )}

                <div class="mt-8 flex items-center gap-4 border-t border-border pt-6">
                  <img
                    src={t.image}
                    alt={`Site of ${t.name}`}
                    width={80}
                    height={80}
                    loading="lazy"
                    class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                  />
                  <div class="min-w-0">
                    <p class="text-xl font-bold leading-none tracking-tighter text-ink">
                      {t.name}
                    </p>
                    <p class="mt-1.5 text-[15px] font-medium leading-none tracking-wide text-muted-foreground">
                      {t.location}
                    </p>
                  </div>
                </div>
              </div>

              {/* Image side */}
              <div class:list={["lg:col-span-5", i % 2 === 1 && "lg:order-1"]}>
                <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
                  <img
                    src={t.image}
                    alt={`Cell site referenced by ${t.name}`}
                    width={500}
                    height={500}
                    loading={i === 0 ? "eager" : "lazy"}
                    class="aspect-square w-full object-cover"
                  />
                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/20 via-transparent to-transparent"
                    aria-hidden="true"
                  />
                  <span class="absolute bottom-3 left-3 rounded-full border border-white/20 bg-black/55 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur">
                    {String(i + 1).padStart(2, "0")} / {String(PAGE_TESTIMONIALS.length).padStart(2, "0")} - Verified
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Base>
